            "expr": {
              "op": "index",
              "args": [
                "u",
                "i"
              ]
            }
          }
        }
      ],
      "initialization_equations": [
        {
          "lhs": "u",
          "rhs": "p0"
        },
        {
          "lhs": "v",
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  2,
                  "p0"
                ]
              },
              "c"
            ]
          }
        },
        {
          "lhs": "aw",
          "rhs": "p0"
        },
        {
          "lhs": "cw",
          "rhs": {
            "op": "+",
            "args": [
              "r0",
              "p0"
            ]
          }
        },
        {
          "lhs": "bw",
          "rhs": {
            "op": "*",
            "args": [
              "q0",
              "aw"
            ]
          }
        }
      ],
      "tolerance": {
        "rel": 1e-09,
        "abs": 1e-11
      },
      "tests": [
        {
          "id": "init_array_defaults",
          "description": "u = p0; v = 2*p0 + 0.5; aw[k, b] = p0[k]; cw[k, b] = r0[b] + p0[k]; bw[k, b] = q0[k, b]*p0[k]; y(1) = u(0).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "u",
              "time": 0.0,
              "expected": 3.0,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "v",
              "time": 0.0,
              "expected": 2.5,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "v",
              "time": 0.0,
              "expected": 6.5,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1,
                "bin": 1
              }
            },
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1,
                "bin": 2
              }
            },
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 2,
                "bin": 2
              }
            },
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 3.0,
              "coords": {
                "lev": 3,
                "bin": 1
              }
            },
            {
              "variable": "cw",
              "time": 0.0,
              "expected": 11.0,
              "coords": {
                "lev": 1,
                "bin": 1
              }
            },
            {
              "variable": "cw",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "lev": 1,
                "bin": 2
              }
            },
            {
              "variable": "cw",
              "time": 0.0,
              "expected": 12.0,
              "coords": {
                "lev": 2,
                "bin": 1
              }
            },
            {
              "variable": "cw",
              "time": 0.0,
              "expected": 23.0,
              "coords": {
                "lev": 3,
                "bin": 2
              }
            },
            {
              "variable": "bw",
              "time": 0.0,
              "expected": 1.0,
              "coords": {
                "lev": 1,
                "bin": 1
              }
            },
            {
              "variable": "bw",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "lev": 2,
                "bin": 2
              }
            },
            {
              "variable": "bw",
              "time": 0.0,
              "expected": 15.0,
              "coords": {
                "lev": 3,
                "bin": 1
              }
            },
            {
              "variable": "y",
              "time": 1.0,
              "expected": 2.0,
              "coords": {
                "lev": 2
              }
            }
          ]
        },
        {
          "id": "init_array_parameter_override",
          "description": "parameter_overrides {c: 1.5} reaches v's initialization equation only.",
          "parameter_overrides": {
            "c": 1.5
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "v",
              "time": 0.0,
              "expected": 3.5,
              "coords": {
                "lev": 1
              }
            },
            {
              "variable": "v",
              "time": 0.0,
              "expected": 7.5,
              "coords": {
                "lev": 3
              }
            },
            {
              "variable": "u",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 2
              }
            }
          ]
        },
        {
          "id": "init_array_run_override",
          "description": "A run's initial_conditions entry for aw[2,1] beats the initialization equation for that cell only, and bw reads it.",
          "initial_conditions": {
            "aw[2,1]": 7.0
          },
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 7.0,
              "coords": {
                "lev": 2,
                "bin": 1
              }
            },
            {
              "variable": "aw",
              "time": 0.0,
              "expected": 2.0,
              "coords": {
                "lev": 2,
                "bin": 2
              }
            },
            {
              "variable": "bw",
              "time": 0.0,
              "expected": 21.0,
              "coords": {
                "lev": 2,
                "bin": 1
              }
            },
            {
              "variable": "bw",
              "time": 0.0,
              "expected": 8.0,
              "coords": {
                "lev": 2,
                "bin": 2
              }
            }
          ]
        }
      ]
    }
  }
}
